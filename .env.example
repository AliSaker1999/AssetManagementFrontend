# Build-time configuration for the SPA.
#
# Vite inlines every VITE_* value into the JavaScript bundle, so anything here is
# readable by anyone who opens the site. URLs only - never a key, password or token.
#
# Local development needs neither variable: client.ts falls back to the relative path
# /api and NotificationContext.tsx to /hubs/notifications, both of which the Vite dev
# proxy forwards to http://localhost:5000 (see vite.config.ts).
#
# The deployed build does need both, because a relative path on Cloudflare Pages would
# resolve against asset.gezairi.com instead of the API. Set them in the Cloudflare Pages
# project under Settings > Environment variables > Production.

VITE_API_BASE_URL=https://assetapi.gezairi.com/api
VITE_HUB_URL=https://assetapi.gezairi.com/hubs/notifications
